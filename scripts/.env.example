# Knocket Inbox Agent 环境变量配置模板
# 复制为 .env 并填入你的配置：cp .env.example .env

# ===== AI 配置（必填）=====
# 支持任意 OpenAI 兼容 API（SiliconFlow / DeepSeek / 通义千问 / 智谱 / 第三方等）
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.siliconflow.cn   # 示例：SiliconFlow（有免费额度）
AI_MODEL=deepseek-ai/DeepSeek-V3         # 示例：DeepSeek V3
AI_PROVIDER=openai                        # 固定填 openai（兼容模式）

# ===== 通知配置（三选一）=====

# --- 方案 A：企微群机器人全自动 ---
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# --- 方案 B：Telegram 人工优先 ---
# TG_BOT_TOKEN=your_telegram_bot_token
# TG_CHAT_ID=your_chat_id

# --- 方案 C：微信人工优先（需要 OpenClaw）⭐ 推荐 ---
# 无需额外配置，通过 OpenClaw 本地 API 发送，见 README

# ===== 运行参数（可选）=====
CHECK_INTERVAL=60          # 检查间隔（秒），默认 60
HUMAN_WAIT_SECONDS=300     # 等待人工回复时间（秒），默认 300（5分钟）
CDP_PORT=9222              # Chrome 调试端口，默认 9222

# KNOCKET_WORK_DIR 留空则自动使用脚本所在目录
# KNOCKET_WORK_DIR=/path/to/knocket-inbox-agent/scripts
